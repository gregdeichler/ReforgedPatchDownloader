<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ReforgedPatchDownloaderApp</AssemblyName>
    <RootNamespace>ReforgedPatchDownloaderApp</RootNamespace>
    <Version>2.3.1</Version>
    <FileVersion>2.3.1.0</FileVersion>
    <AssemblyVersion>2.3.1.0</AssemblyVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\\App.xaml" />
    <Page Include="src\\MainWindow.xaml" />
    <Compile Include="src\\App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="src\\MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="src\\AppUpdateService.cs" />
    <Compile Include="src\\PatchCatalogParser.cs" />
    <Compile Include="src\\PatchDownloaderService.cs" />
    <Compile Include="src\\PatchModels.cs" />
    <Compile Include="src\\SettingsStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\\app.ico" Condition="Exists('assets\\app.ico')" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('assets\\app.ico')">
    <ApplicationIcon>assets\\app.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
