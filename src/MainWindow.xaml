<Window x:Class="ReforgedPatchDownloaderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Project Reforged Patch Downloader 2.1"
        Height="900"
        Width="1440"
        MinHeight="840"
        MinWidth="1280"
        Background="#F5F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D7E0EA" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FBFCFE" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#15314E" />
        <SolidColorBrush x:Key="HeaderAccentBrush" Color="#C89B3C" />
        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="#F6F8FB" />
            <Setter Property="BorderBrush" Value="#D7E0EA" />
            <Setter Property="Foreground" Value="#1A2D43" />
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButtonStyle" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#1E884E" />
            <Setter Property="BorderBrush" Value="#1E884E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Button" x:Key="StopButtonStyle" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#F5D9D9" />
            <Setter Property="BorderBrush" Value="#CC8E8E" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDownloadInProgress}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Border" x:Key="MetricCardStyle">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style TargetType="DataGridColumnHeader" x:Key="CompactHeaderStyle">
            <Setter Property="Background" Value="#EEF3F8" />
            <Setter Property="Foreground" Value="#28415D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="Padding" Value="4,6,4,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" x:Key="FilterTextBoxStyle">
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FCFDFE" />
            <Setter Property="BorderBrush" Value="#D7E0EA" />
        </Style>
        <Style TargetType="ComboBox" x:Key="FilterComboStyle">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="#FCFDFE" />
            <Setter Property="BorderBrush" Value="#D7E0EA" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="20" Padding="22" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Project Reforged Patch Downloader 2.1"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Forge a cleaner Azeroth with a refined HD visual overhaul."
                               Foreground="#D8E7F2"
                               FontSize="14"
                               TextWrapping="Wrap"
                               MaxWidth="900"
                               Margin="0,8,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource HeaderAccentBrush}"
                        Padding="16,10"
                        CornerRadius="16">
                    <TextBlock Text="{Binding StatusText}" Foreground="#1B2636" FontWeight="SemiBold" FontSize="14" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Current Stable" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding StableVersion}" FontSize="24" FontWeight="Bold" Foreground="#17202D" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Site Update Date" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding SiteUpdateDate}" FontSize="24" FontWeight="Bold" Foreground="#17202D" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Last Checked" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding LastCheckedText}" FontSize="18" FontWeight="Bold" Foreground="#17202D" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Selected Downloads" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding SelectedCount}" FontSize="24" FontWeight="Bold" Foreground="#17202D" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}" Background="#FFF9F1" BorderBrush="#F0D8AE">
                <StackPanel>
                    <TextBlock Text="Downloaded Patch Alerts" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding UpdateAlertText}" TextWrapping="Wrap" FontSize="18" FontWeight="Bold" Foreground="#BF6100" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Patch Folder" Foreground="#5E6C7C" />
                        <TextBox Margin="0,8,0,0" Height="34" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,0">
                        <Button Content="Browse" Width="88" Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click" />
                        <Button Content="Check for Updates" Width="154" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" />
                        <Button Content="Patch Notes" Width="112" Style="{StaticResource SecondaryButtonStyle}" Click="PatchNotes_Click" />
                        <Button Content="Project Site" Width="112" Style="{StaticResource SecondaryButtonStyle}" Click="ProjectSite_Click" />
                        <Button Content="Select Recommended" Width="172" Style="{StaticResource SecondaryButtonStyle}" Click="SelectRecommended_Click" />
                        <Button Content="Select Core" Width="94" Style="{StaticResource SecondaryButtonStyle}" Click="SelectCore_Click" />
                        <Button Content="Reset Tracking" Width="118" Style="{StaticResource SecondaryButtonStyle}" Click="ResetTracking_Click" />
                        <Button Content="Stop Downloads"
                                Width="132"
                                Style="{StaticResource StopButtonStyle}"
                                FontWeight="SemiBold"
                                Click="StopDownloads_Click">
                        </Button>
                        <Button Content="Download Selected"
                                Width="170"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="DownloadSelected_Click" />
                    </WrapPanel>
                </Grid>
                <Border Grid.Row="1" Margin="0,12,0,0" Background="#F7FAFD" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="12" Padding="12,10">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DownloadProgressText}"
                               VerticalAlignment="Center"
                               Foreground="#24548F"
                               FontWeight="SemiBold"
                               Margin="0,0,14,0" />
                    <ProgressBar Grid.Column="1"
                                 Height="14"
                                 VerticalAlignment="Center"
                                 Minimum="0"
                                 Maximum="{Binding DownloadProgressMax}"
                                 Value="{Binding DownloadProgressValue}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,14,0">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource FilterTextBoxStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#7B8999"
                                       IsHitTestVisible="False"
                                       Text="Search patches, variants, or categories">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Column="1"
                                  Margin="0,0,14,0"
                                  Style="{StaticResource FilterComboStyle}"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource FilterComboStyle}"
                                  ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              x:Name="PatchGrid"
                              ItemsSource="{Binding VisibleRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF2F7"
                              RowHeaderWidth="0"
                              RowHeight="38"
                              ColumnHeaderHeight="34"
                              Background="#FCFDFE"
                              BorderThickness="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="PatchGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding StatusBrush}" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="BorderBrush" Value="#EEF2F6" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EEF3F8" />
                                <Setter Property="Foreground" Value="#28415D" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderBrush" Value="#D9E2EC" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Get" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="220" IsReadOnly="True" />
                            <DataGridTextColumn Header="Patch" Binding="{Binding PatchName}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Remote" Binding="{Binding RemoteSizeText}" Width="82" IsReadOnly="True" />
                            <DataGridTextColumn Header="Local" Binding="{Binding LocalSizeText}" Width="82" IsReadOnly="True" />
                            <DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="90" IsReadOnly="True" />
                            <DataGridTemplateColumn x:Name="RecommendedColumn" Header="Pick" Width="120" MinWidth="120" IsReadOnly="True" CanUserSort="False" HeaderStyle="{StaticResource CompactHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding RecommendationBrush}"
                                                CornerRadius="11"
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="{Binding RecommendationText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#17314D" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="145" IsReadOnly="True" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedLabel}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Date" Binding="{Binding ReleaseDate}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Rules" Binding="{Binding RuleSummary}" Width="120" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Margin="0,14,0,0"
                               Foreground="#5E6C7C"
                               TextWrapping="Wrap"
                               Text="Orange rows have live updates compared with your tracked downloads. PATCH-B, PATCH-D, and PATCH-E auto-link. PATCH-L and PATCH-U force one active variant." />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0.95*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0.7*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Patch Details" FontSize="20" FontWeight="Bold" Foreground="#17202D" />
                        <Button Grid.Column="1"
                                Content="Open Installed File"
                                Width="150"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="{Binding CanOpenInstalledFile}"
                                Click="OpenInstalledFile_Click" />
                    </Grid>
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,14">
                        <TextBox
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="12.5"
                             Foreground="#22354A"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding DetailsText}" />
                    </Border>
                    <TextBlock Grid.Row="2" Text="What Changed" FontSize="20" FontWeight="Bold" Foreground="#17202D" />
                    <Border Grid.Row="3"
                            Background="White"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,12,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding UpdateSummaryHeaderText}"
                                       Foreground="#4F6073"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <ListBox Grid.Row="1"
                                     x:Name="UpdateSummaryList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding UpdateItems}"
                                     SelectionChanged="UpdateSummaryList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10"
                                                Margin="0,0,0,8"
                                                CornerRadius="12"
                                                Background="#FFF2DE"
                                                BorderBrush="#F0D4A3"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#53360A" />
                                                <TextBlock Text="{Binding VersionChange}"
                                                           Margin="0,3,0,0"
                                                           Foreground="#855B18" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="#8A6C35" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                            </ListBox>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="4" Text="Activity" FontSize="20" FontWeight="Bold" Foreground="#17202D" />
                    <ListBox Grid.Row="5"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Activity}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E1E8F0"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Timestamp}" FontWeight="SemiBold" Foreground="#24548F" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
