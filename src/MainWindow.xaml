<Window x:Class="ReforgedPatchDownloaderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Project Reforged Patch Downloader 2.3"
        Height="960"
        Width="1500"
        MinHeight="960"
        MinWidth="1500"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D7E0EA" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FBFCFE" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#15314E" />
        <SolidColorBrush x:Key="HeaderAccentBrush" Color="#C89B3C" />
        <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11263C" Offset="0" />
            <GradientStop Color="#1B3B5B" Offset="0.58" />
            <GradientStop Color="#234A6A" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="#F6F8FB" />
            <Setter Property="BorderBrush" Value="#D7E0EA" />
            <Setter Property="Foreground" Value="#1A2D43" />
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButtonStyle" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#1E884E" />
            <Setter Property="BorderBrush" Value="#1E884E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Button" x:Key="StopButtonStyle" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#F5D9D9" />
            <Setter Property="BorderBrush" Value="#CC8E8E" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDownloadInProgress}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Border" x:Key="MetricCardStyle">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style TargetType="DataGridColumnHeader" x:Key="CompactHeaderStyle">
            <Setter Property="Background" Value="#EEF3F8" />
            <Setter Property="Foreground" Value="#28415D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="Padding" Value="4,6,4,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" x:Key="FilterTextBoxStyle">
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FCFDFE" />
            <Setter Property="BorderBrush" Value="#D7E0EA" />
        </Style>
        <Style TargetType="ComboBox" x:Key="FilterComboStyle">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="#FCFDFE" />
            <Setter Property="BorderBrush" Value="#D7E0EA" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" CornerRadius="20" Padding="0" Margin="0,0,0,10">
            <Grid>
                <Grid Margin="22,20,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Text="Project Reforged Patch Downloader"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Column="1"
                            Background="#142B44"
                            BorderBrush="#33587C"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18,14"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="SESSION STATUS"
                                       Foreground="#AFC6DA"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <Border Grid.Row="1"
                                    Background="{StaticResource HeaderAccentBrush}"
                                    CornerRadius="14"
                                    Padding="12,7"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#1B2636"
                                           FontWeight="Bold"
                                           FontSize="14" />
                            </Border>
                            <Border Grid.Row="2"
                                    Background="#FFF3D6"
                                    BorderBrush="#E7C47A"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,8"
                                    Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAppUpdateBannerVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding AppUpdateBannerText}"
                                           Foreground="#5E430A"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Current Stable" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding StableVersion}" FontSize="22" FontWeight="Bold" Foreground="#17202D" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Site Update Date" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding SiteUpdateDate}" FontSize="22" FontWeight="Bold" Foreground="#17202D" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Last Checked" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding LastCheckedText}" FontSize="17" FontWeight="Bold" Foreground="#17202D" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Selected Downloads" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding SelectedCount}" FontSize="22" FontWeight="Bold" Foreground="#17202D" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}" Background="#FFF9F1" BorderBrush="#F0D8AE" Padding="12">
                <StackPanel>
                    <TextBlock Text="Downloaded Patch Alerts" Foreground="#5E6C7C" />
                    <TextBlock Text="{Binding UpdateAlertText}" TextWrapping="Wrap" FontSize="17" FontWeight="Bold" Foreground="#BF6100" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Patch Folder" Foreground="#5E6C7C" />
                    <TextBox Margin="0,8,0,0"
                             Height="34"
                             Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Content="Browse" Width="84" Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click" />
                    <Button Content="Check for Updates" Width="146" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" />
                    <Button Content="Update Installed" Width="130" Style="{StaticResource SecondaryButtonStyle}" Click="UpdateInstalled_Click" IsEnabled="{Binding CanUpdateInstalled}" />
                    <Button Content="Select Recommended" Width="160" Style="{StaticResource SecondaryButtonStyle}" Click="SelectRecommended_Click" />
                    <Button Content="Select Core" Width="88" Style="{StaticResource SecondaryButtonStyle}" Click="SelectCore_Click" />
                    <Button Content="Reset Tracking" Width="110" Style="{StaticResource SecondaryButtonStyle}" Click="ResetTracking_Click" />
                    <Button Content="Verify Files" Width="92" Style="{StaticResource SecondaryButtonStyle}" Click="VerifyFiles_Click" />
                    <Button Content="Check App Updates" Width="136" Style="{StaticResource SecondaryButtonStyle}" Click="CheckAppUpdates_Click" />
                    <Button Content="Patch Notes" Width="104" Style="{StaticResource SecondaryButtonStyle}" Click="PatchNotes_Click" />
                    <Button Content="Project Site" Width="104" Style="{StaticResource SecondaryButtonStyle}" Click="ProjectSite_Click" />
                    <Button Content="Stop Downloads"
                            Width="124"
                            Style="{StaticResource StopButtonStyle}"
                            FontWeight="SemiBold"
                            Click="StopDownloads_Click">
                    </Button>
                    <Button Content="Download Selected"
                            Width="162"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="DownloadSelected_Click" />
                </WrapPanel>
                <Border Grid.Row="2" Margin="0,8,0,0" Background="#F7FAFD" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="12" Padding="10,8">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DownloadProgressText}"
                               VerticalAlignment="Center"
                               Foreground="#24548F"
                               FontWeight="SemiBold"
                               Margin="0,0,14,0" />
                    <ProgressBar Grid.Column="1"
                                 Height="12"
                                 VerticalAlignment="Center"
                                 Minimum="0"
                                 Maximum="{Binding DownloadProgressMax}"
                                 Value="{Binding DownloadProgressValue}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.45*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,14,0">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource FilterTextBoxStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#7B8999"
                                       IsHitTestVisible="False"
                                       Text="Search patches, variants, or categories">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Column="1"
                                  Margin="0,0,14,0"
                                  Style="{StaticResource FilterComboStyle}"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource FilterComboStyle}"
                                  ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              x:Name="PatchGrid"
                              ItemsSource="{Binding VisibleRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF2F7"
                              RowHeaderWidth="0"
                              RowHeight="38"
                              ColumnHeaderHeight="34"
                              Background="#FCFDFE"
                              BorderThickness="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="PatchGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding StatusBrush}" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="BorderBrush" Value="#EEF2F6" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EEF3F8" />
                                <Setter Property="Foreground" Value="#28415D" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderBrush" Value="#D9E2EC" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Get" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="220" IsReadOnly="True" />
                            <DataGridTextColumn Header="Patch" Binding="{Binding PatchName}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Remote" Binding="{Binding RemoteSizeText}" Width="82" IsReadOnly="True" />
                            <DataGridTextColumn Header="Local" Binding="{Binding LocalSizeText}" Width="82" IsReadOnly="True" />
                            <DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="90" IsReadOnly="True" />
                            <DataGridTemplateColumn x:Name="RecommendedColumn" Header="Pick" Width="120" MinWidth="120" IsReadOnly="True" CanUserSort="False" HeaderStyle="{StaticResource CompactHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding RecommendationBrush}"
                                                CornerRadius="11"
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="{Binding RecommendationText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#17314D" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="145" IsReadOnly="True" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedLabel}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Date" Binding="{Binding ReleaseDate}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Rules" Binding="{Binding RuleSummary}" Width="120" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,0"
                               Foreground="#5E6C7C"
                               TextWrapping="Wrap"
                               Text="Orange rows have live updates compared with your tracked downloads. PATCH-B, PATCH-D, and PATCH-E auto-link. PATCH-L and PATCH-U force one active variant." />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0.98*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0.44*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0.46*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#F6FAFF"
                            BorderBrush="#DCE6F2"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFirstRunHelpVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="First Run Guide" FontSize="16" FontWeight="Bold" Foreground="#17314D" />
                                <TextBlock Text="{Binding FirstRunHelpText}" TextWrapping="Wrap" Foreground="#44607F" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Dismiss"
                                    Width="88"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DismissFirstRunHelp_Click" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Patch Details" FontSize="20" FontWeight="Bold" Foreground="#17202D" />
                        <WrapPanel Grid.Column="1">
                            <Button Content="Release Notes"
                                    Width="108"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="PatchNotes_Click" />
                            <Button Content="Repair Selected"
                                    Width="116"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding CanRepairSelection}"
                                    Click="RepairSelected_Click" />
                            <Button Content="Open File Location"
                                    Width="150"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding CanOpenInstalledFile}"
                                    Click="OpenInstalledFile_Click" />
                        </WrapPanel>
                    </Grid>
                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,10">
                        <TextBox
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="12.5"
                             Foreground="#22354A"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Visible"
                             Text="{Binding DetailsText}" />
                    </Border>
                    <TextBlock Grid.Row="3"
                               Text="Install Guidance"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#17202D" />
                    <Border Grid.Row="4"
                            Background="#F8FBFE"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,10,0,10">
                        <TextBlock Text="{Binding SelectedPatchGuidanceText}"
                                   Foreground="#35506B"
                                   TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Grid.Row="5" Text="What Changed" FontSize="20" FontWeight="Bold" Foreground="#17202D" />
                    <Border Grid.Row="6"
                            Background="White"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,10,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding UpdateSummaryHeaderText}"
                                       Foreground="#4F6073"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <ListBox Grid.Row="1"
                                     x:Name="UpdateSummaryList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding UpdateItems}"
                                     SelectionChanged="UpdateSummaryList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10"
                                                Margin="0,0,0,8"
                                                CornerRadius="12"
                                                Background="#FFF2DE"
                                                BorderBrush="#F0D4A3"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#53360A" />
                                                <TextBlock Text="{Binding VersionChange}"
                                                           Margin="0,3,0,0"
                                                           Foreground="#855B18" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="#8A6C35" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                            </ListBox>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="7" Text="History &amp; Activity" FontSize="20" FontWeight="Bold" Foreground="#17202D" />
                    <TabControl Grid.Row="8"
                                Margin="0,10,0,0"
                                Background="Transparent"
                                BorderBrush="#DDE6F0">
                        <TabItem Header="History">
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding HistoryHeaderText}"
                                           Foreground="#4F6073"
                                           TextWrapping="Wrap"
                                           Margin="8,8,8,6" />
                                <ListBox Grid.Row="1"
                                         Margin="4"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemsSource="{Binding History}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    BorderBrush="#E1E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TimestampText}" FontWeight="SemiBold" Foreground="#24548F" />
                                                    <TextBlock Text="{Binding Title}" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="#21364D" />
                                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding FolderPath}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#68798B" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Activity">
                            <ListBox Margin="4"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding Activity}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="#E1E8F0"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Timestamp}" FontWeight="SemiBold" Foreground="#24548F" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
